# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit the real .env — it is gitignored.
# cp .env.example .env

# Backend port
PORT=5000

# Secret used to sign JWT tokens for admin auth.
# Generate your own with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-string"

# ---- Supabase Postgres ----
# Get these from your Supabase project dashboard:
#   click "Connect" (top right) -> "Prisma" / "Connection string"

# Transaction-mode pooler (port 6543) — used by the running app at runtime.
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.<YOUR-PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (port 5432) — used by Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres.<YOUR-PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Your database password (keep in sync with the ones above)
SUPABASE_PASSWORD="<YOUR-PASSWORD>"

# ---- Supabase Storage (product image uploads) ----
# From Project Settings -> API
#   Project URL:  https://<your-project-ref>.supabase.co
#   service_role key (server-side only, NEVER expose to the browser)
SUPABASE_URL="https://<YOUR-PROJECT-REF>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_<YOUR-SERVICE-ROLE-KEY>"
# Public storage bucket name (create under Storage -> New bucket, make it Public)
SUPABASE_STORAGE_BUCKET="product-images"
